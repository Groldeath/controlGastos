# Configuración Global - Control de Gastos (Entorno de Producción/LXC)

# -----------------
# BACKEND
# -----------------
PORT=3000
HOST=0.0.0.0

# Base de Datos (PostgreSQL en LXC externo)
# Estos valores serán inyectados por Gitea Secrets en el CI/CD
DB_HOST=192.168.1.100
DB_PORT=5432
DB_USER=controlgastos_user
DB_PASSWORD=super_secure_password
DB_NAME=controlgastos_db

# Seguridad
# JWT secreto para firmas
JWT_SECRET=tu_secreto_jwt_super_seguro_aqui_inyectado_por_ci

# -----------------
# FRONTEND
# -----------------
# Variables que Vite consumirá (deben empezar con VITE_)
VITE_API_URL=https://api.tudominio.com

# -----------------
# AUTENTICACION OIDC (Pocket ID)
# -----------------
# La URL de tu instancia de Pocket ID. Asegurate de incluir .well-known/openid-configuration al probar
OIDC_ISSUER_URL=https://auth.tudominio.com
OIDC_CLIENT_ID=client_id_generico_aqui
OIDC_CLIENT_SECRET=client_secret_generico_aqui
# URL Pública de esta app para generar la redirección correcta de vuelta (callback).
APP_PUBLIC_URL=https://gastos.tudominio.com
